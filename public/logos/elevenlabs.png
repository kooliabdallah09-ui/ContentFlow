views/audio?payload=eyJ2b2ljZV9zb3VyY2UiOiJjdXN0b20iLCJ1c2VyX2lkIjoiVjRtZFBYN0g1ZFp1M2Rua0dpalRCOUVKTW82MyIsImZpbGVuYW1lIjoiRks4cmh5ejA1M2tPQWRnN0JRMEIubXAzIiwidGltZXN0YW1wIjoxNzg1NTEzNjAwMDAwMDAwfQ%3D%3D\",\"category\":\"Advertisement\",\"description\":\"Christopher - smooth narrator - Smooth, deep, promotional type voice, perfect for social media, advertisements, professional narration, books and more!\",\"shortDescription\":\"Persuasive voices that drive action and brand recall.\",\"link\":\"https://elevenlabs.io/app/voice-library?use_cases=advertisement\"},{\"voiceId\":\"flHkNRp1BlvT73UL6gyz\",\"name\":\"Jessica Anne Bogart - Eloquent Villain\",\"previewUrl\":\"https://storage.googleapis.com/eleven-public-prod/database/workspace/fb1bd18708014d8d80e770df5ea11bb7/voices/flHkNRp1BlvT73UL6gyz/Wi2FL0vNQp7bJAeSrJaz.mp3\",\"category\":\"Characters\",\"description\":\"Jessica Anne Bogart - Character and Animation - The Villain! Wickedly eloquent. Calculating. Cruel and calm.\",\"shortDescription\":\"Playful and engaging voices for cartoons or video games.\",\"link\":\"https://elevenlabs.io/app/voice-library?use_cases=characters_animation\"},{\"voiceId\":\"EkK5I93UQWFDigLMpZcX\",\"name\":\"James - Husky Storyteller\",\"previewUrl\":\"https://storage.googleapis.com/eleven-public-prod/database/workspace/48ab3aae468d4e9baded4b1693820088/voices/EkK5I93UQWFDigLMpZcX/117d85a7-853f-482d-bf48-2d169f399830.mp3\",\"category\":\"Narration\",\"description\":\"James - Husky \u0026 Engaging - A slightly husky and bassy voice with a standard American accent. Modulated, controlled, and direct and perfect for audiobooks, captivating narrations, or storytelling, or other professional voiceover work.\",\"shortDescription\":\"Expressive voices that bring audiobooks and podcasts to life.\",\"link\":\"https://elevenlabs.io/app/voice-library?use_cases=narrative_story\"},{\"voiceId\":\"UgBBYS2sOqTuMpoF3BR0\",\"name\":\"Mark - Natural Conversations\",\"previewUrl\":\"https://storage.googleapis.c