se/user/Bi4YhYxPTDRSUfiEpED4qyJ0biq2/voices/NOpBlnGInO9m6vDvFkFC/M4xySW4rr1SbAKKwMAtI.mp3\",\"category\":\"Conversational\",\"description\":\"Grandpa Spuds Oxley - A friendly grandpa who knows how to enthrall his audience with tall tales and fun adventures.\"},{\"voiceId\":\"EkK5I93UQWFDigLMpZcX\",\"name\":\"James - Husky Storyteller\",\"previewUrl\":\"https://storage.googleapis.com/eleven-public-prod/database/workspace/48ab3aae468d4e9baded4b1693820088/voices/EkK5I93UQWFDigLMpZcX/117d85a7-853f-482d-bf48-2d169f399830.mp3\",\"category\":\"Narration\",\"description\":\"James - Husky \u0026 Engaging - A slightly husky and bassy voice with a standard American accent. Modulated, controlled, and direct and perfect for audiobooks, captivating narrations, or storytelling, or other professional voiceover work.\",\"shortDescription\":\"Expressive voices that bring audiobooks and podcasts to life.\",\"link\":\"https://elevenlabs.io/app/voice-library?use_cases=narrative_story\"},{\"voiceId\":\"56AoDkrOh6qfVPDXZ7Pt\",\"name\":\"Cassidy - Crisp Podcaster\",\"previewUrl\":\"https://storage.googleapis.com/eleven-public-prod/database/workspace/1da06ea679a54975ad96a2221fe6530d/voices/56AoDkrOh6qfVPDXZ7Pt/oEgVi6mikkKcpVcTFfj5.mp3\",\"category\":\"Conversational\",\"description\":\"Cassidy - A confident female podcaster with plethora of experience in the music industry.\"},{\"voiceId\":\"tnSpp4vdxKPjI9w0GnoV\",\"name\":\"Hope - Social Media\",\"previewUrl\":\"https://storage.googleapis.com/eleven-public-prod/custom/voices/tnSpp4vdxKPjI9w0GnoV/LiIyxRT1qFJ1QJPr8sWl.mp3\",\"category\":\"Social Media\",\"description\":\"upbeat\",\"shortDescription\":\"Trendy, attention-grabbing voices for short-form content.\",\"link\":\"https://elevenlabs.io/app/voice-library?use_cases=social_media\"},{\"voiceId\":\"uju3wxzG5OhpWcoi3SMy\",\"name\":\"Michael C. Vincent - Suspenseful Storyteller\",\"previewUrl\":\"https://storage.googleapis.com/eleven-public-prod/custom/voices/uju3wxzG5OhpWcoi3SMy/ixYUu11jiy8LIVZidnvA.mp3\",\"category\":\"Narration\",\"description\":\"Michael C. Vincent - A confident and expressive narrator across multiple genres. Warm bass tones and crisp high-end clarity deliver an articulate, intelligent voice suited for commercials, explainers, educational narrations and storytelling.\"},{\"voiceId\":\"G17SuINrv2H9FC6nvetn\",\"name\":\"Christopher - British Storyteller\",\"previewUrl\":\"https://storage.googleapis.com/eleven-public-prod/custom/voices/G17SuINrv2H9FC6nvetn/ofEmJDtVvrmeL3OEs0ig.mp3\",\"category\":\"Narration\",\"description\":\"Christopher - British male narrator, English, well-spoken, gentle and trustworthy voice. Great for audiobooks, podcasts and voiceovers.\"},{\"voiceId\":\"IRHApOXLvnW57QJPQH2P\",\"name\":\"Adam - Dark Storyteller\",\"previewUrl\":\"https://api.us.elevenlabs.io/v1/voices/IRHApOXLvnW57QJPQH2P/previews/audio?payload=eyJ2b2ljZV9zb3VyY2UiOiJjdXN0b20iLCJ1c2VyX2lkIjoiNEdXZzBVd1FLWGJpVkZPMFRybDRqTURTVGI4MiIsImZpbGVuYW1lIjoiNjQ3MTEwODMtZTliOS00NDhjLWIyODQtZjFlMjBlYjVlNDRhLm1wMyIsInRpbWVzdGFtcCI6MTc4NTUxMzYwMDAwMDAwMH0%3D\",\"category\":\"Characters\",\"description\":\"Adam - Brooding, Dark, Tough American - A tough hero, weathered by years of experience. American accent.\",\"shortDescription\":\"Playful and engaging voices for cartoons or video games.\",\"link\":\"https://elevenlabs.io/app/voice-library?use_cases=characters_animation\"},{\"voiceId\":\"EiNlNiXeDU1pqqOPrYMO\",\"name\":\"John Doe - Gravely Storyteller\",\"previewUrl\":\"https://storage.googleapis.com/eleven-public-prod/database/user/8RYUsFHsalUXjwVG0LjhNwH1j022/voices/EiNlNiXeDU1pqqOPrYMO/DyICRR04KQnCeB7Y9B7K.mp3\",\"category\":\"Narration\",\"description\":\"John Doe - Deep - Middle aged American male with a very deep voice. Perfect for audiobooks.\"},{\"voiceId\":\"1SM7GgM6IMuvQlz2BwM3\",\"name\":\"Mark - Friendly Companion\",\"previewUrl\":\"https://api.us.elevenlabs.io/v1/voices/1SM7GgM6IMuvQlz2BwM3/previews/audio?payload=eyJ2b2ljZV9zb3VyY2UiOiJjdXN0b20