ckground-color:var(--marker-background-color, #FDFCFC)"><div class="tw-rounded-full tw-bg-black tw-size-0.5"></div></div><div class="tw-absolute tw-z-20 tw-flex tw-size-5 tw-items-center tw-justify-center tw-rounded-full tw-bottom-0 tw-right-0 tw-translate-x-1/2 tw-translate-y-1/2" style="background-color:var(--marker-background-color, #FDFCFC)"><div class="tw-rounded-full tw-bg-black tw-size-0.5"></div></div></div><div><h3 class="tw-type-xl tw-text-black tw-text-balance"><a class="tw-group/link tw-rounded tw-outline-none focus-visible:tw-outline-focus tw-relative" href="/text-to-speech-api">Text to Speech API<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="tw-absolute tw-size-4 tw-inline tw-ml-1.5 tw-mt-1.5 tw-opacity-0 group-hover/link:tw-opacity-100 tw-transition-opacity group-focus/link:tw-opacity-100 [&_*]:[vector-effect:non-scaling-stroke]"><path d="M18.25 15.25V5.75M18.25 5.75H8.75M18.25 5.75L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a></h3><div class="tw-mt-4"><div class="tw-type-base tw-text-gray-500 tw-text-pretty [&_a]:tw-underline [&_a]:tw-decoration-gray-300 [&_a]:tw-underline-offset-2 hover:[&_a]:tw-decoration-gray-400 [&_a]:tw-transition-colors [&_a]:tw-rounded-sm [&_a]:tw-outline-none focus-visible:[&_a]:tw-outline-focus"><p>Independently rated the leading Text to Speech models. Choose a model to optimize for consistency, latency or emotional control. All support 29+ languages.</p></div></div><div class="tw-grid tw-gap-8 tw-grid-cols-1 sm:tw-grid-cols-2 tw-mt-12"><div><h4 class="tw-type-sm tw-text-black">Eleven Flash</h4><p class="tw-type-sm tw-mt-3 tw-text-gray-500">75ms latency for conversational usecases</p></div><div><h4 class="tw-type-sm tw-text-black">Eleven Multilingual</h4><p class="tw-type-sm tw-mt-3 tw-text-gray-500">Best lifelike consistent speech</p></div><div><h4 class="tw-type-sm tw-text-black">Eleven v3</h4><p class="tw-type-sm tw-mt-3 tw-text-gray-500">Our most expressive model yet</p></div></div></div></div><div aria-hidden="true" class="tw-hidden tw-w-px lg:tw-block tw-bg-black/5"></div><div class="tw-px-4 tw-pb-4 lg:tw-pt-4 tw-flex"><div class="tw-group/code tw-bg-white tw-flex tw-w-full tw-relative tw-overflow-hidden has-[>:focus-visible]:tw-outline-focus" style="box-shadow:0 0 1px rgb(0 0 0 / 0.4), 0 1px 1px rgb(0 0 0 / 0.04), 0 2px 4px rgb(0 0 0 / 0.04);border-top-left-radius:1.25rem;border-top-right-radius:1.25rem;border-bottom-right-radius:1.25rem;border-bottom-left-radius:1.25rem"><div class="tw-outline-none tw-w-full tw-py-6 tw-rounded-3xl tw-flex tw-scrollbar-none tw-overflow-auto" aria-label="Text to speech API TypeScript example"><div class="tw-sticky tw-left-0 tw-w-6 tw-flex-none" style="background:linear-gradient(to right, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.98726) 8.07%, rgba(255, 255, 255, 0.95141) 15.54%, rgba(255, 255, 255, 0.896) 22.5%, rgba(255, 255, 255, 0.82459) 29.04%, rgba(255, 255, 255, 0.74074) 35.26%, rgba(255, 255, 255, 0.648) 41.25%, rgba(255, 255, 255, 0.54993) 47.1%, rgba(255, 255, 255, 0.45007) 52.9%, rgba(255, 255, 255, 0.352) 58.75%, rgba(255, 255, 255, 0.25926) 64.74%, rgba(255, 255, 255, 0.17541) 70.96%, rgba(255, 255, 255, 0.104) 77.5%, rgba(255, 255, 255, 0.04859) 84.46%, rgba(255, 255, 255, 0.01274) 91.93%, rgba(255, 255, 255, 0) 100%)"></div><pre style="font-variant-ligatures:none" class="[&_code]:tw-font-mono [&_code]:tw-block tw-text-2xs/[1.375rem] tw-text-black"><code><span style="color:#F41A2F">import</span> { ElevenLabsClient } <span style="color:#F41A2F">from</span><span style="color:#052F70"> "@elevenlabs/elevenlabs-js"</span>;

<span style="color:#F41A2F">const</span><span style="color:#0A59D2"> client</span> = new ElevenLabsClient({ <span style="color:#0A59D2">apiKey:</span><span style="color:#052F70"> "YOUR_API_KEY"</span> });

<span style="color:#F41A2F">await</span> client.textToSpeech.convert(<span style="color:#052F70">"JBFqnCBsd6RMkjVDRZzb"</span>, {
<span style="color:#0A59D2">  outputFormat:</span><span style="color:#052F70"> "mp3_44100_128"</span>,
<span style="color:#0A59D2">  text:</span><span style="color:#052F70"> "The first move is what sets everything in motion."</span>,
<span style="color:#0A59D2">  modelId:</span><span style="color:#052F70"> "eleven_multilingual_v2"</span>,
});</code></pre><div class="tw-sticky tw-right-0 tw-w-6 tw-flex-none tw-ml-12" style="background:linear-gradient(to left, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.98726) 8.07%, rgba(255, 255, 255, 0.95141) 15.54%, rgba(255, 255, 255, 0.896) 22.5%, rgba(255, 255, 255, 0.82459) 29.04%, rgba(255, 255, 255, 0.74074) 35.26%, rgba(255, 255, 255, 0.648) 41.25%, rgba(255, 255, 255, 0.54993) 47.1%, rgba(255, 255, 255, 0.45007) 52.9%, rgba(255, 255, 255, 0.352) 58.75%, rgba(255, 255, 255, 0.25926) 64.74%, rgba(255, 255, 255, 0.17541) 70.96%, rgba(255, 255, 255, 0.104) 77.5%, rgba(255, 255, 255, 0.04859) 84.46%, rgba(255, 255, 255, 0.01274) 91.93%, rgba(255, 255, 255, 0) 100%)"></div></div><div class="tw-absolute tw-isolate tw-top-3 tw-right-3 can-hover:tw-opacity-0 group-hover/code:tw-opacity-100 group-has-[:focus]/code:tw-opacity-100 tw-transition-opacity"><div class="tw-absolute -tw-z-10 -tw-bottom-6 -tw-left-6 tw-size-24" style="background:radial-gradient(50% 50% at center, #fff calc(100% - 1rem), #fff0)"></div><button type="button" class="tw-rounded-full tw-size-9 tw-flex tw-items-center tw-justify-center tw-transition-colors tw-outline-none focus-visible:tw-outline-focus tw-bg-gray-50 hover:tw-bg-gray-100" aria-label="Copy"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="tw-size-5 [&_*]:[vector-effect:non-scaling-stroke]"><path d="M15.25 15.25V20C15.25 20.6904 14.6904 21.25 14 21.25H4C3.30964 21.25 2.75 20.6904 2.75 20V10C2.75 9.30964 3.30964 8.75 4 8.75H8.75M10 15.25H20C20.6904 15.25 21.25 14.6904 21.25 14V4C21.25 3.30964 20.6904 2.75 20 2.75H10C9.30964 2.75 8.75 3.30964 8.75 4V14C8.75 14.6904 9.30964 15.25 10 15.25Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div></div></div></div></div></div></div></div><div class="block-section" style="--marker-background-color:#FDFCFC"><div class="relative container border-l border-r border-overlay-dark"><div class><div class="tw-absolute tw-z-20 t